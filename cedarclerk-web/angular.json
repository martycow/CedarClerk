{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "cedarclerk-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "vollkorn-@(latin|cyrillic)-@(600|700)-normal.woff2",
                "input": "node_modules/@fontsource/vollkorn/files",
                "output": "assets/fonts"
              },
              {
                "glob": "source-sans-3-@(latin|cyrillic)-@(400|600)-normal.woff2",
                "input": "node_modules/@fontsource/source-sans-3/files",
                "output": "assets/fonts"
              },
              {
                "glob": "literata-@(latin|cyrillic)-@(400|600)-normal.woff2",
                "input": "node_modules/@fontsource/literata/files",
                "output": "assets/fonts"
              },
              {
                "glob": "martian-mono-@(latin|cyrillic)-@(400|600|700)-normal.woff2",
                "input": "node_modules/@fontsource/martian-mono/files",
                "output": "assets/fonts"
              },
              {
                "glob": "caveat-@(latin|cyrillic)-500-normal.woff2",
                "input": "node_modules/@fontsource/caveat/files",
                "output": "assets/fonts"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/katex/dist/katex.min.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "850kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "34kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cedarclerk-web:build:production"
            },
            "development": {
              "buildTarget": "cedarclerk-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
