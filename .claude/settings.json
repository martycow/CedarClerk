{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/ui-inventory-reminder.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the UI inventory"
          }
        ]
      }
    ]
  }
}
